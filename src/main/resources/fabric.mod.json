{
    "schemaVersion": 1,
    "id": "purityhud",
    "name": "PurityHUD",
    "version": "${mod_version}",

	"description": "Configurable \"mini-F3\" info lines, and various overlay renderers. MiniHUD fork for Purity Vanilla server.",
	"authors": [
		"masa"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/minihud",
		"issues": "https://github.com/maruohon/minihud/issues",
		"sources": "https://github.com/maruohon/minihud",
		"twitter": "https://twitter.com/maruohon",
		"discord": "https://discordapp.com/channels/211786369951989762/453662800460644354/"
	},
	"license": "LGPLv3",
	"icon": "assets/minihud/icon.png",

	"environment": "client",
	"entrypoints": {
		"main": [
			"fi.dy.masa.minihud.MiniHUD"
		],
		"modmenu": [
			"fi.dy.masa.minihud.compat.modmenu.ModMenuImpl"
		]
	},
	"mixins": [
		"mixins.minihud.json"
	],
    "accessWidener": "purityhud.accesswidener",

	"depends": {
		"minecraft": "1.21.11",
		"malilib": ">=0.27.7- <0.28.0-"
	},
	"breaks": {
		"malilib": "<0.27.7-"
	}
}
